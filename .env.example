# Copy this file to .env and enter values privately in your editor.
# The server loads .env; existing shell variables take precedence.
# Empty key: heuristic extraction and template documents; no built-in code repair.
OPENAI_API_KEY=

# Optional model overrides. Empty values allow startup discovery/fallbacks.
OPENAI_MODEL=
OPENAI_DOC_MODEL=
OPENAI_FIX_MODEL=

# Local server settings; the inbox Vite proxy expects port 4477.
SEYRIN_PORT=4477
# 1 = headless Kane; 0 = visible browser.
KANE_HEADLESS=0

# Optional: openai, claude, codex, or a JSON command argument array.
# Empty keeps the per-app agent in seyrin.config.json.
FIX_AGENT=

# Runtime override; npm run start:offline sets this in its launching shell.
# Empty here selects the real kane-cli binary.
KANE_CLI_BIN=

# Landing-page build setting: set this in the shell when building the site.
# The server's .env loader does not configure Vite's build environment.
VITE_APP_URL=
