{
  "name": "seyrin",
  "private": true,
  "type": "module",
  "description": "Seyrin: agents in your inbox that get the work done, and prove it with Kane CLI.",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "start": "node scripts/start.mjs",
    "start:offline": "KANE_CLI_BIN=scripts/fake-kane-cli.mjs node scripts/start.mjs",
    "app:build": "vite build app",
    "app:dev": "vite app",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "demo:reset": "curl -s -X POST http://127.0.0.1:4477/v1/admin/reset || true",
    "gate": "node gate/kane-gate.mjs --check demo-app",
    "gate:watch": "node gate/kane-gate.mjs --watch demo-app",
    "spec": "node gate/spec-to-flows.mjs specs/perch-core.md",
    "bench": "node bench/scenario.mjs && node bench/run.mjs && node bench/compare.mjs",
    "bench:compare": "node bench/compare.mjs",
    "bench:measure": "node bench/run.mjs",
    "bench:manual": "node bench/stopwatch.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
